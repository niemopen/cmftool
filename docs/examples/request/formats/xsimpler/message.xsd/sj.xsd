<?xml version="1.0" encoding="UTF-8"?>
<xs:schema
  targetNamespace="http://example.com/Request/1.0/xsimpler"
  xmlns:sj="http://example.com/Request/1.0/xsimpler"
  xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:complexType name="ItemType">
    <xs:annotation>
      <xs:documentation>A data type for an article or thing.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element ref="sj:name"/>
      <xs:element ref="sj:quantity"/>
    </xs:sequence>
  </xs:complexType>
  <xs:simpleType name="NumericType">
    <xs:annotation>
      <xs:documentation>A data type for a number value.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:decimal"/>
  </xs:simpleType>
  <xs:complexType name="QuantityType">
    <xs:annotation>
      <xs:documentation>A data type for a count or tally.</xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="sj:NumericType">
        <xs:attribute ref="sj:units"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <xs:complexType name="RequestType">
    <xs:annotation>
      <xs:documentation>A data type for a request of one or more items.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element ref="sj:id"/>
      <xs:element ref="sj:item" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>
  <xs:simpleType name="TextType">
    <xs:annotation>
      <xs:documentation>A data type for a character string.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string"/>
  </xs:simpleType>
  <xs:attribute name="units" type="xs:string">
    <xs:annotation>
      <xs:documentation>A unit of counting or tallying for a quantity.</xs:documentation>
    </xs:annotation>
  </xs:attribute>
  <xs:element name="id" type="xs:token">
    <xs:annotation>
      <xs:documentation>An identifier for a request.</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:element name="item" type="sj:ItemType">
    <xs:annotation>
      <xs:documentation>A request for a specified quantity of an item.</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:element name="name" type="sj:TextType">
    <xs:annotation>
      <xs:documentation>A name of an item.</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:element name="quantity" type="sj:QuantityType">
    <xs:annotation>
      <xs:documentation>A count of the individual units which make up an item.</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:element name="request" type="sj:RequestType">
    <xs:annotation>
      <xs:documentation>A request for one or more items.</xs:documentation>
    </xs:annotation>
  </xs:element>
</xs:schema>
