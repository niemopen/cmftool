  </Namespace>
  <Namespace structures:id="t">
    <NamespaceURI>http://example.com/test/</NamespaceURI>
    <NamespacePrefixText>t</NamespacePrefixText>
    <DocumentationText>
      Attribute augmentation test
    </DocumentationText>
    <ConformanceTargetURI>https://docs.oasis-open.org/niemopen/ns/specification/NDR/6.0/#SubsetSchemaDocument</ConformanceTargetURI>
    <DocumentFilePathText>attAug.xsd</DocumentFilePathText>
    <NamespaceCategoryCode>EXTENSION</NamespaceCategoryCode>
    <NamespaceVersionText>1</NamespaceVersionText>
    <ArchitectureVersionName>NIEM6.0</ArchitectureVersionName>
    <NamespaceLanguageName>en-US</NamespaceLanguageName>
    <AugmentationRecord>
      <Class structures:ref="nc.EducationType" xsi:nil="true"/>
      <DataProperty structures:ref="t.attProp" xsi:nil="true"/>
      <MinOccursQuantity>1</MinOccursQuantity>
      <MaxOccursQuantity>1</MaxOccursQuantity>
    </AugmentationRecord>
    <AugmentationRecord>
      <Class structures:ref="nc.TextType" xsi:nil="true"/>
      <DataProperty structures:ref="t.attProp" xsi:nil="true"/>
      <MinOccursQuantity>0</MinOccursQuantity>
      <MaxOccursQuantity>1</MaxOccursQuantity>
    </AugmentationRecord>
  </Namespace>
  <Namespace structures:id="xs">
    <NamespaceURI>http://www.w3.org/2001/XMLSchema</NamespaceURI>
    <NamespacePrefixText>xs</NamespacePrefixText>
    <NamespaceCategoryCode>XSD</NamespaceCategoryCode>
  </Namespace>
  <ObjectProperty structures:id="nc.Comment">
    <Name>Comment</Name>
    <Namespace structures:ref="nc" xsi:nil="true"/>
    <Class structures:ref="nc.CommentType" xsi:nil="true"/>
  </ObjectProperty>
  <ObjectProperty structures:id="nc.CommentText">
    <Name>CommentText</Name>
    <Namespace structures:ref="nc" xsi:nil="true"/>
    <DocumentationText>A comment, note, or remark providing additional information.</DocumentationText>
    <Class structures:ref="nc.TextType" xsi:nil="true"/>
  </ObjectProperty>
  <ObjectProperty structures:id="nc.EducationDescriptionText">
    <Name>EducationDescriptionText</Name>
    <Namespace structures:ref="nc" xsi:nil="true"/>
    <DocumentationText>A description of a person's educational background.</DocumentationText>
    <Class structures:ref="nc.TextType" xsi:nil="true"/>
  </ObjectProperty>
  <ObjectProperty structures:id="nc.PersonEducation">
    <Name>PersonEducation</Name>
    <Namespace structures:ref="nc" xsi:nil="true"/>
    <DocumentationText>A person's educational background.</DocumentationText>
    <Class structures:ref="nc.EducationType" xsi:nil="true"/>
  </ObjectProperty>
  <DataProperty structures:id="nc.TextLiteral">
    <Name>TextLiteral</Name>
    <Namespace structures:ref="nc" xsi:nil="true"/>
    <DocumentationText>A data type for a character string.</DocumentationText>
    <Datatype structures:ref="xs.string" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="t.attProp">
    <Name>attProp</Name>
    <Namespace structures:ref="t" xsi:nil="true"/>
    <Datatype structures:ref="xs.token" xsi:nil="true"/>
