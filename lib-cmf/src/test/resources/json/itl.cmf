    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>CORE</FacetValue>
      <DocumentationText>Unusually distinctive core area</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>CREASE</FacetValue>
      <DocumentationText>Unusually distinctive crease</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>DELTA</FacetValue>
      <DocumentationText>Unusually distinctive delta area</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>DYSPLASIA</FacetValue>
      <DocumentationText>Disassociated ridges; dysplasia</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
