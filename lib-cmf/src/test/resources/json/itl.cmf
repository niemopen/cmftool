    <RestrictionBase structures:ref="xs.token" xsi:nil="true"/>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>A</FacetValue>
      <DocumentationText>Auto</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>M</FacetValue>
      <DocumentationText>Manual ridge count</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>T</FacetValue>
      <DocumentationText>Manual tracing; auto ridge count</DocumentationText>
    </Facet>
  </Restriction>
  <Restriction structures:id="biom.MinutiaeRidgeCountResidualCodeType">
    <Name>MinutiaeRidgeCountResidualCodeType</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A data type for a half of the octant in which a neighboring minutia lies</DocumentationText>
    <RestrictionBase structures:ref="xs.integer" xsi:nil="true"/>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>0</FacetValue>
      <DocumentationText>Neighboring minutia lies in the clockwise half of the octant</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>1</FacetValue>
      <DocumentationText>Neighboring minutia lies in the counterclockwise half of the octant</DocumentationText>
    </Facet>
  </Restriction>
  <Restriction structures:id="biom.MinutiaeRidgeEdgeOrDiscontinuityCategoryCodeType">
    <Name>MinutiaeRidgeEdgeOrDiscontinuityCategoryCodeType</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
