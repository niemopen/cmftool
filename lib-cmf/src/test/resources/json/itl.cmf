    <DocumentationText>A kind of Radiograph Image Series. Only integer and periods are in the code text. An example is 8.1.3.9.1.5 for the National Provider Identifier Number of Dentist that treated the patient.</DocumentationText>
    <Datatype structures:ref="nc.TextType" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.RadiographImageSeriesText">
    <Name>RadiographImageSeriesText</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A kind of radiograph image in series text</DocumentationText>
    <Datatype structures:ref="nc.TextType" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.RadiographSizeText">
    <Name>RadiographSizeText</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A kind of Radiograph Size</DocumentationText>
    <Datatype structures:ref="nc.TextType" xsi:nil="true"/>
  </DataProperty>
  <ObjectProperty structures:id="biom.RecordCreationDate">
    <Name>RecordCreationDate</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A kind of date that a specific biometric data record was created.</DocumentationText>
    <Class structures:ref="nc.DateType" xsi:nil="true"/>
  </ObjectProperty>
  <DataProperty structures:id="biom.RecordingAssignedVoiceCategoryCode">
    <Name>RecordingAssignedVoiceCategoryCode</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A kind of first information item is the assigned voice indicator / AVI. It is mandatory if this field is used. It indicates if the voice recording sample was obtained from a known subject.</DocumentationText>
    <Datatype structures:ref="biom.RecordingAssignedVoiceCategoryCodeType" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.RecordingAwarenessCode">
    <Name>RecordingAwarenessCode</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>An indication of whether a data subject is aware that a recording is being made.</DocumentationText>
    <Datatype structures:ref="biom.RecordingAwarenessCodeType" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.RecordingBitDepthValue">
    <Name>RecordingBitDepthValue</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A total number of bits that are used to represent a single sample of digital media.</DocumentationText>
    <Datatype structures:ref="biom.Integer0to1024Type" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.RecordingChannelsQuantity">
    <Name>RecordingChannelsQuantity</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A count of the channels of data represented in a digital media data file.</DocumentationText>
    <Datatype structures:ref="biom.Integer1to9999Type" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.RecordingCompressedBytesQuantity">
    <Name>RecordingCompressedBytesQuantity</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A quantity representing the total number of compressed bytes in a digital recording stored as a data file.</DocumentationText>
    <Datatype structures:ref="xs.positiveInteger" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.RecordingContentCommentText">
    <Name>RecordingContentCommentText</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A kind of comment that allows statements of up to 4000 Unicode characters in length describing methods by which the plurality and nationality of the speakers was determined, along with any supporting text.</DocumentationText>
    <Datatype structures:ref="biom.LongCommentType" xsi:nil="true"/>
  </DataProperty>
  <ObjectProperty structures:id="biom.RecordingContentDescriptor">
    <Name>RecordingContentDescriptor</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A kind of content of the voice recording.</DocumentationText>
    <Class structures:ref="biom.RecordingContentDescriptorType" xsi:nil="true"/>
  </ObjectProperty>
  <DataProperty structures:id="biom.RecordingDuration">
    <Name>RecordingDuration</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A number that gives the total length of a recording in microseconds.</DocumentationText>
    <Datatype structures:ref="xs.positiveInteger" xsi:nil="true"/>
  </DataProperty>
  <ObjectProperty structures:id="biom.RecordingDurationDetail">
    <Name>RecordingDurationDetail</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A description of the duration of a recording, as expressed in time, size, and samplings.</DocumentationText>
    <Class structures:ref="biom.RecordingDurationDetailType" xsi:nil="true"/>
  </ObjectProperty>
  <DataProperty structures:id="biom.RecordingEndianCode">
    <Name>RecordingEndianCode</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>An ordering of individually addressable sub-components (bytes) within the representation of a recording.</DocumentationText>
    <Datatype structures:ref="biom.EndianCodeType" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.RecordingSampleQuantity">
    <Name>RecordingSampleQuantity</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A number that gives the total number of samples in a recorded data file after any decompression of the compressed signal.</DocumentationText>
    <Datatype structures:ref="xs.positiveInteger" xsi:nil="true"/>
  </DataProperty>
  <ObjectProperty structures:id="biom.RecordingSettingDetail">
    <Name>RecordingSettingDetail</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A description of the details surrounding the creation of a recording</DocumentationText>
    <Class structures:ref="biom.RecordingSettingDetailType" xsi:nil="true"/>
  </ObjectProperty>
  <DataProperty structures:id="biom.RecordingSourceCategoryCode">
    <Name>RecordingSourceCategoryCode</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A kind of site or agency that created a recording.</DocumentationText>
    <Datatype structures:ref="biom.RecordingSourceCategoryCodeType" xsi:nil="true"/>
  </DataProperty>
  <ObjectProperty structures:id="biom.RecordingSourceCountry">
    <Name>RecordingSourceCountry</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A country code, describing where a recording was created.</DocumentationText>
    <SubPropertyOf structures:ref="biom.SourceCountryCodeAbstract" xsi:nil="true"/>
    <Class structures:ref="nc.CountryType" xsi:nil="true"/>
  </ObjectProperty>
  <DataProperty structures:id="biom.RecordingSpeedRate">
    <Name>RecordingSpeedRate</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A rate of speed at which the physical media object must be played to reproduce the signal content.</DocumentationText>
    <Datatype structures:ref="xs.decimal" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.RecordingSpeedUnitText">
    <Name>RecordingSpeedUnitText</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A unit of measure of the rate of speed at which the physical media object must be played to reproduce the signal content.</DocumentationText>
    <Datatype structures:ref="nc.TextType" xsi:nil="true"/>
  </DataProperty>
  <ObjectProperty structures:id="biom.RecordMinutiaeAbstract">
    <Name>RecordMinutiaeAbstract</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A data concept for a minutiae record</DocumentationText>
    <AbstractIndicator>true</AbstractIndicator>
  </ObjectProperty>
  <ObjectProperty structures:id="biom.RedactionDiaryInformation">
    <Name>RedactionDiaryInformation</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A data type indicates that redaction has occurred and lists the timings within the voice recording of redacted (overwritten) audio segments.</DocumentationText>
    <Class structures:ref="biom.DiaryInformationType" xsi:nil="true"/>
  </ObjectProperty>
  <ObjectProperty structures:id="biom.RedactionInformation">
    <Name>RedactionInformation</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A data type for an indication of whether and by whom a voice recording has been redacted.</DocumentationText>
    <Class structures:ref="biom.AudioInformationType" xsi:nil="true"/>
  </ObjectProperty>
  <DataProperty structures:id="biom.RelativeEndTimeInMSValue">
    <Name>RelativeEndTimeInMSValue</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>An indication in microseconds the time of the end of the redaction relative to the beginning of the voice recording</DocumentationText>
    <Datatype structures:ref="xs.positiveInteger" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.RelativeStartTimeInMSValue">
    <Name>RelativeStartTimeInMSValue</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>An indication in microseconds the time of the start of the redaction relative to the beginning of the voice recording</DocumentationText>
    <Datatype structures:ref="xs.positiveInteger" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.ResolutionCommentText">
    <Name>ResolutionCommentText</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A comment provided by the examiner about the resolution method.</DocumentationText>
    <Datatype structures:ref="nc.TextType" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.ResolutionMeansCode">
    <Name>ResolutionMeansCode</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>An information item for means of determining resolution.</DocumentationText>
    <Datatype structures:ref="biom.ResolutionMeansCodeType" xsi:nil="true"/>
  </DataProperty>
  <ObjectProperty structures:id="biom.ResolutionMethodInformation">
    <Name>ResolutionMethodInformation</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>An optional field states the method used for determining the pixel density of the image.</DocumentationText>
    <Class structures:ref="biom.ResolutionMethodInformationType" xsi:nil="true"/>
  </ObjectProperty>
  <DataProperty structures:id="biom.ResolutionScaleLengthValue">
    <Name>ResolutionScaleLengthValue</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A known scale units, specifies the length of the known scale from point A to point B.</DocumentationText>
    <Datatype structures:ref="xs.decimal" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.ResolutionScaleUnitCode">
    <Name>ResolutionScaleUnitCode</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A known scale units indicates whether the known scales units are in inches or millimeters.</DocumentationText>
    <Datatype structures:ref="biom.ResolutionScaleUnitCodeType" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.ResolutionScaleXCoordinateAValue">
    <Name>ResolutionScaleXCoordinateAValue</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A known scale x coordinate for point A is expressed in number of pixels from the left of the image.</DocumentationText>
    <Datatype structures:ref="xs.nonNegativeInteger" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.ResolutionScaleXCoordinateBValue">
    <Name>ResolutionScaleXCoordinateBValue</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A known scale x coordinate for point B is expressed in number of pixels from the left of the image.</DocumentationText>
    <Datatype structures:ref="xs.nonNegativeInteger" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.ResolutionScaleYCoordinateAValue">
    <Name>ResolutionScaleYCoordinateAValue</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A known scale y coordinate for point A is expressed in number of pixels from the top of the image.</DocumentationText>
    <Datatype structures:ref="xs.nonNegativeInteger" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.ResolutionScaleYCoordinateBValue">
    <Name>ResolutionScaleYCoordinateBValue</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A known scale y coordinate for point B is expressed in number of pixels from the top of the image.</DocumentationText>
    <Datatype structures:ref="xs.nonNegativeInteger" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.RestorationDataGranularityCode">
    <Name>RestorationDataGranularityCode</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A code indicates the type and level of restoration and surface information coded in Field 12.010: Tooth data detail / TDD.</DocumentationText>
    <Datatype structures:ref="biom.RestorationDataGranularityCodeType" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.RidgeCountMaximumValue">
    <Name>RidgeCountMaximumValue</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A maximum number of friction ridges between two features on an image</DocumentationText>
    <Datatype structures:ref="biom.Integer0to99Type" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.RidgeCountMinimumValue">
    <Name>RidgeCountMinimumValue</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A minimum number of friction ridges between two features on an image</DocumentationText>
    <Datatype structures:ref="biom.Integer0to99Type" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.RidgeCountReferenceID">
    <Name>RidgeCountReferenceID</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>An index identifier for a distant minutia point</DocumentationText>
    <Datatype structures:ref="xs.string" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.RidgeCountValue">
    <Name>RidgeCountValue</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A number of friction ridges between two features on an image</DocumentationText>
    <Datatype structures:ref="xs.nonNegativeInteger" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.RulerScaleMakeText">
    <Name>RulerScaleMakeText</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A make of a ruler or scale</DocumentationText>
    <Datatype structures:ref="nc.TextType" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.RulerScaleModelText">
    <Name>RulerScaleModelText</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A model of a ruler or scale</DocumentationText>
    <Datatype structures:ref="nc.TextType" xsi:nil="true"/>
  </DataProperty>
  <ObjectProperty structures:id="biom.RulerScalePresenceInformation">
    <Name>RulerScalePresenceInformation</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>An optional field allows the user to state whether a ruler or other known scale is present in the image.</DocumentationText>
    <SubPropertyOf structures:ref="biom.RulerScalePresenceInformationFormAbstract" xsi:nil="true"/>
    <Class structures:ref="biom.RulerScalePresenceInformationType" xsi:nil="true"/>
  </ObjectProperty>
  <ObjectProperty structures:id="biom.RulerScalePresenceInformationFormAbstract">
    <Name>RulerScalePresenceInformationFormAbstract</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A data concept that allows the user to state whether a ruler or other known scale is present in the image including standard fingerprint form number(but not both).</DocumentationText>
    <AbstractIndicator>true</AbstractIndicator>
  </ObjectProperty>
  <DataProperty structures:id="biom.RulerScaleUnitCode">
    <Name>RulerScaleUnitCode</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A unit of measurement visible on the ruler or measurement scale.</DocumentationText>
    <Datatype structures:ref="biom.RulerScaleUnitCodeType" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.SamplingRate">
    <Name>SamplingRate</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A ratio of digital samples per second of analog data upon conversion to an acoustic signal</DocumentationText>
    <Datatype structures:ref="xs.nonNegativeInteger" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.ScanningResolutionCategoryCode">
    <Name>ScanningResolutionCategoryCode</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>An indication of whether minimal (nominal) or native scanning resolution applies to a biometric image.</DocumentationText>
    <Datatype structures:ref="biom.ScanningResolutionCategoryCodeType" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.ScriptText">
    <Name>ScriptText</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A script used for read, prompted or repeated speech.</DocumentationText>
    <Datatype structures:ref="nc.TextType" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.SegmentBottomVerticalCoordinateValue">
    <Name>SegmentBottomVerticalCoordinateValue</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A bottom vertical offset of a segment box within an image in pixels</DocumentationText>
    <Datatype structures:ref="xs.nonNegativeInteger" xsi:nil="true"/>
  </DataProperty>
  <ObjectProperty structures:id="biom.SegmentChannelInformation">
    <Name>SegmentChannelInformation</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A list of details about transducers used across a recording.</DocumentationText>
    <Class structures:ref="biom.SegmentChannelInformationType" xsi:nil="true"/>
  </ObjectProperty>
  <DataProperty structures:id="biom.SegmentContentCommentText">
    <Name>SegmentContentCommentText</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A comment on the content of the segment.</DocumentationText>
    <Datatype structures:ref="nc.TextType" xsi:nil="true"/>
  </DataProperty>
  <ObjectProperty structures:id="biom.SegmentContentInformation">
    <Name>SegmentContentInformation</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A field for an assessment of the content of the voice data within a list of identified time segments, including provision for semantic transcripts, phonetic transcriptions and translations of the segments.</DocumentationText>
    <Class structures:ref="biom.SegmentContentInformationType" xsi:nil="true"/>
  </ObjectProperty>
  <DataProperty structures:id="biom.SegmentFingerViewCode">
    <Name>SegmentFingerViewCode</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A kind of full finger view</DocumentationText>
    <Datatype structures:ref="biom.FingerViewCodeType" xsi:nil="true"/>
  </DataProperty>
  <ObjectProperty structures:id="biom.SegmentGeographicalLocation">
    <Name>SegmentGeographicalLocation</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A geographical location of the primary subject of a recording at the beginning of a recording segment.</DocumentationText>
    <Class structures:ref="biom.SegmentGeographicalLocationType" xsi:nil="true"/>
  </ObjectProperty>
  <DataProperty structures:id="biom.SegmentID">
    <Name>SegmentID</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>An identifier for a specific time segment.</DocumentationText>
    <Datatype structures:ref="xs.positiveInteger" xsi:nil="true"/>
  </DataProperty>
  <ObjectProperty structures:id="biom.SegmentIDList">
    <Name>SegmentIDList</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A list of segment identifiers.</DocumentationText>
    <Class structures:ref="biom.SegmentIDListType" xsi:nil="true"/>
  </ObjectProperty>
  <DataProperty structures:id="biom.SegmentLeftHorizontalCoordinateValue">
    <Name>SegmentLeftHorizontalCoordinateValue</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A left horizontal offset of a segment box within an image in pixels</DocumentationText>
    <Datatype structures:ref="xs.nonNegativeInteger" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.SegmentLocationCode">
    <Name>SegmentLocationCode</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A location of a segment of a finger, e.g. distal, medial, or proximal</DocumentationText>
    <Datatype structures:ref="biom.SegmentLocationCodeType" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.SegmentPhoneticTranscriptText">
    <Name>SegmentPhoneticTranscriptText</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A phonetic transcription of the contents of an identified list of time segments.</DocumentationText>
    <Datatype structures:ref="nc.TextType" xsi:nil="true"/>
  </DataProperty>
  <ObjectProperty structures:id="biom.SegmentProcessingPriorityInformation">
    <Name>SegmentProcessingPriorityInformation</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A list of identified segments, indicating the priority with which the segments should be processed.</DocumentationText>
    <Class structures:ref="biom.SegmentProcessingPriorityType" xsi:nil="true"/>
  </ObjectProperty>
  <DataProperty structures:id="biom.SegmentRecordingEndDateTime">
    <Name>SegmentRecordingEndDateTime</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A local end time of the original, contemporaneous capture of the voice recording in the segment identified.</DocumentationText>
    <Datatype structures:ref="xs.dateTime" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.SegmentRecordingStartDateTime">
    <Name>SegmentRecordingStartDateTime</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A local start time of the original, contemporaneous capture of the voice recording in the segment identified.</DocumentationText>
    <Datatype structures:ref="xs.dateTime" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.SegmentRightHorizontalCoordinateValue">
    <Name>SegmentRightHorizontalCoordinateValue</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A right horizontal offset of a segment box within an image in pixels</DocumentationText>
    <Datatype structures:ref="xs.nonNegativeInteger" xsi:nil="true"/>
  </DataProperty>
  <ObjectProperty structures:id="biom.SegmentSpeakerCharacteristicsInformation">
    <Name>SegmentSpeakerCharacteristicsInformation</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A list of speaker speech characteristics assessments.</DocumentationText>
    <Class structures:ref="biom.SegmentSpeakerCharacteristicsInformationType" xsi:nil="true"/>
  </ObjectProperty>
  <DataProperty structures:id="biom.SegmentTopVerticalCoordinateValue">
    <Name>SegmentTopVerticalCoordinateValue</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A top vertical offset of a segment box within an image in pixels</DocumentationText>
    <Datatype structures:ref="xs.nonNegativeInteger" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.SegmentTranscriptLanguageCode">
    <Name>SegmentTranscriptLanguageCode</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A 3 character ISO 639-3 code for the transcript language.</DocumentationText>
    <Datatype structures:ref="iso_639-3.LanguageCodeType" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.SegmentTranscriptText">
    <Name>SegmentTranscriptText</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A semantic transcription of the contents of an identified list of time segments.</DocumentationText>
    <Datatype structures:ref="nc.TextType" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.SegmentTranslationLanguageCode">
    <Name>SegmentTranslationLanguageCode</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A 3 character ISO 639-3 code for the translation language.</DocumentationText>
    <Datatype structures:ref="iso_639-3.LanguageCodeType" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.SegmentTranslationText">
    <Name>SegmentTranslationText</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A translation into a language other than the one in which the original segment was spoken.</DocumentationText>
    <Datatype structures:ref="nc.TextType" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.SmallThetaAngleMeasure">
    <Name>SmallThetaAngleMeasure</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>An angle between 0 and 179 degrees</DocumentationText>
    <Datatype structures:ref="biom.SmallAngleMeasureType" xsi:nil="true"/>
  </DataProperty>
  <ObjectProperty structures:id="biom.SourceAcquisition">
    <Name>SourceAcquisition</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>An acquisition method for the source representation</DocumentationText>
    <Class structures:ref="biom.SourceAcquisitionType" xsi:nil="true"/>
  </ObjectProperty>
  <DataProperty structures:id="biom.SourceCommentText">
    <Name>SourceCommentText</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A comment about a source representation</DocumentationText>
    <Datatype structures:ref="nc.TextType" xsi:nil="true"/>
  </DataProperty>
  <ObjectProperty structures:id="biom.SourceCountryCodeAbstract">
    <Name>SourceCountryCodeAbstract</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A data concept for a country code, describing where a recording was created.</DocumentationText>
    <AbstractIndicator>true</AbstractIndicator>
  </ObjectProperty>
  <DataProperty structures:id="biom.SourceExternalFileReferenceText">
    <Name>SourceExternalFileReferenceText</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A URI, URL or other unique reference to a storage location for a source representation.</DocumentationText>
    <SubPropertyOf structures:ref="biom.SourceExternalReferenceAbstract" xsi:nil="true"/>
    <SubPropertyOf structures:ref="itl.ChoiceAbstract_3" xsi:nil="true"/>
    <Datatype structures:ref="nc.TextType" xsi:nil="true"/>
  </DataProperty>
  <ObjectProperty structures:id="biom.SourceExternalReferenceAbstract">
    <Name>SourceExternalReferenceAbstract</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A data concept for defining an external source representation</DocumentationText>
    <AbstractIndicator>true</AbstractIndicator>
  </ObjectProperty>
  <DataProperty structures:id="biom.SourceFileCategoryText">
    <Name>SourceFileCategoryText</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A kind of file holding a source representation, represented as a file suffix or other description of the file</DocumentationText>
