    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>N</FacetValue>
      <DocumentationText>This record does not have an assigned identity as the subject of the record</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>Q</FacetValue>
      <DocumentationText>The recording contains a questioned voice</DocumentationText>
    </Facet>
  </Restriction>
