    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>49</FacetValue>
      <DocumentationText>Left index/middle/ring</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>50</FacetValue>
      <DocumentationText>Left middle/ring/little</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>51</FacetValue>
