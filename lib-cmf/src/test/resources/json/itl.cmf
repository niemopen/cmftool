    <Datatype structures:ref="biom.FeaturePointCategoryCodeType" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.FeaturePointHorizontalCoordinateValue">
    <Name>FeaturePointHorizontalCoordinateValue</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>An X coordinate of a facial feature point</DocumentationText>
    <Datatype structures:ref="xs.nonNegativeInteger" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.FeaturePointID">
    <Name>FeaturePointID</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>An identifier for a particular feature point, defined by ISO/IEC 14496-2</DocumentationText>
    <Datatype structures:ref="nc.TextType" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.FeaturePointVerticalCoordinateValue">
    <Name>FeaturePointVerticalCoordinateValue</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
