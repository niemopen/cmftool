  <Restriction structures:id="biom.ImageCompressionAlgorithmCodeType">
    <Name>ImageCompressionAlgorithmCodeType</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A data type for an image compression algorithm</DocumentationText>
    <RestrictionBase structures:ref="xs.integer" xsi:nil="true"/>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>0</FacetValue>
      <DocumentationText>NONE - Uncompressed</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>1</FacetValue>
      <DocumentationText>WSQ20 - WSQ Version 3.1 or higher (Version 2.0 or Version 3.0 may be used for platen areas less than 2 inches in height)</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>2</FacetValue>
      <DocumentationText>JPEGB - JPEG ISO/IEC 10918 (Lossy)</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>3</FacetValue>
      <DocumentationText>JPEGL - JPEG ISO/IEC 10918 (Lossless)</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>4</FacetValue>
      <DocumentationText>JP2 - JPEG 2000 ISO/IEC 15444-1 (Lossy)</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>5</FacetValue>
      <DocumentationText>JP2L - JPEG 2000 ISO/IEC 15444-1 (Lossless)</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>6</FacetValue>
      <DocumentationText>PNG - Portable Network Graphics</DocumentationText>
    </Facet>
  </Restriction>
  <Restriction structures:id="biom.ImageDistortionCategoryCodeType">
    <Name>ImageDistortionCategoryCodeType</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A data type for a kind of distortion in an image</DocumentationText>
    <RestrictionBase structures:ref="xs.token" xsi:nil="true"/>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>Barrel</FacetValue>
      <DocumentationText>Spherized</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>Inflated</FacetValue>
      <DocumentationText>Wide angle or fisheye distortion</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>Pincushion</FacetValue>
      <DocumentationText>Pinched at the center, or bowed inwards</DocumentationText>
    </Facet>
  </Restriction>
  <Restriction structures:id="biom.ImageDistortionMeasurementCodeType">
