  <Restriction structures:id="biom.MorphologyPositionalNumberingCodeType">
    <Name>MorphologyPositionalNumberingCodeType</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A data type to indicate whether the assignment of tooth numbers was done on a morphological basis or positional basis.</DocumentationText>
    <RestrictionBase structures:ref="xs.token" xsi:nil="true"/>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>0</FacetValue>
      <DocumentationText>Unknown</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>1</FacetValue>
      <DocumentationText>Developer specified morphological coding</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>2</FacetValue>
      <DocumentationText>Developer specified positional coding</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>3</FacetValue>
      <DocumentationText>Coder specified morphological coding independent of developer specification</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>4</FacetValue>
      <DocumentationText>Coder specified positional coding independent of developer specification</DocumentationText>
    </Facet>
  </Restriction>
