    <UnionMemberDatatype structures:ref="biom.QualityScoreFailureCodeType" xsi:nil="true"/>
    <UnionMemberDatatype structures:ref="biom.Integer0to100Type" xsi:nil="true"/>
  </Union>
  <Restriction structures:id="biom.RecordingAssignedVoiceCategoryCodeType">
    <Name>RecordingAssignedVoiceCategoryCodeType</Name>
