  <Restriction structures:id="biom.PhysicalFeatureCategoryCodeType">
    <Name>PhysicalFeatureCategoryCodeType</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A data type for a kind of physical feature</DocumentationText>
    <RestrictionBase structures:ref="xs.token" xsi:nil="true"/>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>BIRTHMARK</FacetValue>
      <DocumentationText>Tissue that is differentiated from normal tissue but is not the result of an accident or medical procedure, such as a 'blood stain' birthmark on part of the face</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>BRANDED</FacetValue>
      <DocumentationText>Image burned into the skin using a branding iron or other form of heat</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>CHEMICAL</FacetValue>
      <DocumentationText>Image created by the use of chemicals to burn the image into the skin</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>CUT</FacetValue>
      <DocumentationText>Image caused by an incision of the skin</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>IMPLANT</FacetValue>
      <DocumentationText>Sub-dermal implants that are visible as distinct shapes in the skin. This category may also be used to indicate jewelry that has been (semi-)permanently affixed to the body _ such as plugs in the earlobes or a microdermal implant that has a jewel ab</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>MARK</FacetValue>
      <DocumentationText>Pattern resulting from needle or track marks</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>MISSING</FacetValue>
      <DocumentationText>A missing information</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>PIERCING</FacetValue>
      <DocumentationText>Deliberately made hole through body tissue, usually to wear body ornamentation</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>SCAR</FacetValue>
      <DocumentationText>Healed scar tissue that was the result of an accident or medical procedure</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>TATTOO</FacetValue>
      <DocumentationText>A common tattoo or indelible image resulting from the pricking of the skin with a coloring matter</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>ZABIBA</FacetValue>
      <DocumentationText>Commonly referred to as a 'prayer bump' on the forehead</DocumentationText>
    </Facet>
  </Restriction>
