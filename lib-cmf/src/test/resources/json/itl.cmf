    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>OTHERFEAT</FacetValue>
      <DocumentationText>Other unusual features not characterized elsewhere; details should be noted in comments</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>SCAR</FacetValue>
      <DocumentationText>Scar</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>WART</FacetValue>
      <DocumentationText>Wart or blister</DocumentationText>
    </Facet>
  </Restriction>
  <Restriction structures:id="biom.MinutiaeExaminerComparisonDeterminationResultCodeType">
    <Name>MinutiaeExaminerComparisonDeterminationResultCodeType</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A data type for a result of an examiner's comparison of friction ridge impressions</DocumentationText>
    <RestrictionBase structures:ref="xs.token" xsi:nil="true"/>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>EX_SRC</FacetValue>
      <DocumentationText>Exclusion of source</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>EX_SUB</FacetValue>
      <DocumentationText>Exclusion of subject</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>INC_C</FacetValue>
      <DocumentationText>Inconclusive, but with corresponding features noted</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>INC_D</FacetValue>
      <DocumentationText>Inconclusive, but with dissimilar features noted</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>INC_I</FacetValue>
      <DocumentationText>Inconclusive due to insufficient information</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>INC_N</FacetValue>
      <DocumentationText>Inconclusive due to no overlapping area</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>INDIV</FacetValue>
      <DocumentationText>Individualization</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>NONE</FacetValue>
      <DocumentationText>No determination</DocumentationText>
    </Facet>
  </Restriction>
