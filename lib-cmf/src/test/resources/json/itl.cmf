  <Restriction structures:id="biom.MinutiaeLocalQualityIssuesCategoryCodeType">
    <Name>MinutiaeLocalQualityIssuesCategoryCodeType</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A data type for a kind of localized friction ridge transfer quality issue</DocumentationText>
    <RestrictionBase structures:ref="xs.token" xsi:nil="true"/>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>ARTIFACT</FacetValue>
      <DocumentationText>Digital artifacts, such as occasionally caused by compression or livescan devices</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>BACKGROUND</FacetValue>
      <DocumentationText>Interference with background makes following ridges difficult (e.g. check patterns)</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>COMPRESSED</FacetValue>
      <DocumentationText>Distorted area in which ridges are compressed together</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>DISTORT</FacetValue>
      <DocumentationText>Miscellaneous distortion (See also Compressed and Stretched)</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>NEGATIVE</FacetValue>
      <DocumentationText>Used if only a portion of the friction ridge image is tonally reversed (has ridges and valleys inverted so that ridges appear white and valleys appear black). Note that the FrictionRidgeImageTonalReversalCode element is used if the entire image is t</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>OTHER</FacetValue>
      <DocumentationText>Other quality issues not characterized elsewhere; details should be noted in comments</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>OVERDEV</FacetValue>
      <DocumentationText>Overdeveloped area: excessive processing medium such as ink, powder, etc.</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>OVERLAP</FacetValue>
      <DocumentationText>Area in which another friction ridge impression is superimposed over the impression of interest</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>SMEAR</FacetValue>
      <DocumentationText>Smeared or smudged area</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>STRETCHED</FacetValue>
      <DocumentationText>Distorted area in which ridges are stretched apart from each other</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>TAPE</FacetValue>
      <DocumentationText>Lifting tape artifacts (crease, bubble, etc.)</DocumentationText>
    </Facet>
  </Restriction>
  <Restriction structures:id="biom.MinutiaeRidgeCountConfidenceValueType">
    <Name>MinutiaeRidgeCountConfidenceValueType</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A data type for a degree of confidence in a ridge count between two points</DocumentationText>
    <RestrictionBase structures:ref="xs.nonNegativeInteger" xsi:nil="true"/>
    <Facet>
      <FacetCategoryCode>maxInclusive</FacetCategoryCode>
      <FacetValue>99</FacetValue>
    </Facet>
  </Restriction>
  <Restriction structures:id="biom.MinutiaeRidgeCountMethodCodeType">
    <Name>MinutiaeRidgeCountMethodCodeType</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
