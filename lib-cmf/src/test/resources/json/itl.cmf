  <Restriction structures:id="itl.SignatureCategoryCodeType">
    <Name>SignatureCategoryCodeType</Name>
    <Namespace structures:ref="itl" xsi:nil="true"/>
    <DocumentationText>A data type for a kind of signature image, i.e. whether an image is the signature of the subject, or the signature of the official processing the transaction</DocumentationText>
    <RestrictionBase structures:ref="xs.integer" xsi:nil="true"/>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>0</FacetValue>
