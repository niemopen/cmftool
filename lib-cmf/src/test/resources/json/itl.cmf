    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>I</FacetValue>
      <DocumentationText>Indentation</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>P</FacetValue>
      <DocumentationText>Protrusion</DocumentationText>
    </Facet>
  </Restriction>
  <Restriction structures:id="biom.MinutiaeRidgeFlowMapFormatCodeType">
    <Name>MinutiaeRidgeFlowMapFormatCodeType</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A data type for a format of ridge flow values in the ridge flow map</DocumentationText>
    <RestrictionBase structures:ref="xs.token" xsi:nil="true"/>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>B64</FacetValue>
      <DocumentationText>Base 64</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>UNC</FacetValue>
      <DocumentationText>Uncompressed (concatenated hexadecimal)</DocumentationText>
    </Facet>
  </Restriction>
  <Restriction structures:id="biom.MinutiaeRidgeQualityMapFormatCodeType">
    <Name>MinutiaeRidgeQualityMapFormatCodeType</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A data type for a format of ridge quality values in the ridge quality map</DocumentationText>
    <RestrictionBase structures:ref="xs.token" xsi:nil="true"/>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>RLE</FacetValue>
      <DocumentationText>Run-Length encoded</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>UNC</FacetValue>
      <DocumentationText>Uncompressed (concatenated decimal)</DocumentationText>
    </Facet>
  </Restriction>
  <Restriction structures:id="biom.MinutiaeRidgeWavelengthMapFormatCodeType">
    <Name>MinutiaeRidgeWavelengthMapFormatCodeType</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A data type for a format of ridge wavelength values in the ridge wavelength map</DocumentationText>
    <RestrictionBase structures:ref="xs.token" xsi:nil="true"/>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>UNC</FacetValue>
      <DocumentationText>Uncompressed (concatenated 2-character decimal values)</DocumentationText>
    </Facet>
  </Restriction>
  <Restriction structures:id="biom.MinutiaeValueAssessmentResultCodeType">
    <Name>MinutiaeValueAssessmentResultCodeType</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A data type for a result of an examiner's assessment of the value of the friction ridge impression</DocumentationText>
    <RestrictionBase structures:ref="xs.token" xsi:nil="true"/>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>LIMITED</FacetValue>
      <DocumentationText>The impression is of limited, marginal, value. It is not of value for individualization, but may be appropriate for exclusion</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>NONPRINT</FacetValue>
      <DocumentationText>The image is not a friction ridge impression</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>NOVALUE</FacetValue>
      <DocumentationText>The impression is of no value, is not appropriate for further analysis, and has no use for potential comparison</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>VALUE</FacetValue>
      <DocumentationText>The impression is of value and is appropriate for further analysis and potential comparison. Sufficient details exist to render an individualization and/or exclusion decision</DocumentationText>
    </Facet>
  </Restriction>
