  <Restriction structures:id="biom.ProcessingIndicatorCodeType">
    <Name>ProcessingIndicatorCodeType</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A data type for a Redaction/Discontinuity Indicator Code.</DocumentationText>
    <RestrictionBase structures:ref="xs.integer" xsi:nil="true"/>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>0</FacetValue>
      <DocumentationText>No redaction occurred or there are no discontinuous signals on the recording</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>1</FacetValue>
      <DocumentationText>Redaction has occurred or there are discontinuities.</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>2</FacetValue>
      <DocumentationText>The organization creating this record is not able to assert or does not assert that redaction has occurred or not occurred/there are or are not discontinuities in the recording.</DocumentationText>
    </Facet>
  </Restriction>
  <Restriction structures:id="biom.QualityScoreFailureCodeType">
    <Name>QualityScoreFailureCodeType</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
