  </Restriction>
  <Restriction structures:id="nc.ProperNameTextType">
    <Name>ProperNameTextType</Name>
    <Namespace structures:ref="nc" xsi:nil="true"/>
    <DocumentationText>A data type for a word or phrase by which a person or thing is known, referred, or addressed.</DocumentationText>
    <RestrictionBase structures:ref="nc.TextType" xsi:nil="true"/>
  </Restriction>
  <Restriction structures:id="nc.QuantityType">
    <Name>QuantityType</Name>
    <Namespace structures:ref="nc" xsi:nil="true"/>
    <DocumentationText>A data type for a count or tally.</DocumentationText>
    <RestrictionBase structures:ref="nc.NumericType" xsi:nil="true"/>
  </Restriction>
  <Restriction structures:id="nc.TextType">
    <Name>TextType</Name>
    <Namespace structures:ref="nc" xsi:nil="true"/>
    <DocumentationText>A data type for a character string.</DocumentationText>
    <RestrictionBase structures:ref="xs.string" xsi:nil="true"/>
  </Restriction>
  <Restriction structures:id="nc.UTMCoordinateType">
    <Name>UTMCoordinateType</Name>
    <Namespace structures:ref="nc" xsi:nil="true"/>
    <DocumentationText>A data type for a coordinate from the Universal Transverse Mercator (UTM) Coordinate System, which represents a location with a hemisphere, zone, an easting value, and a northing value.</DocumentationText>
    <RestrictionBase structures:ref="xs.token" xsi:nil="true"/>
    <Facet>
      <FacetCategoryCode>pattern</FacetCategoryCode>
      <FacetValue>(0[1-9]|[1-5][0-9]|60)([NS])([0-9]{6}[0-9]{7})</FacetValue>
      <DocumentationText>A 16-character pattern representing a UTM coordinate: a 2-digit UTM zone number, a 1-character hemisphere, a 6-digit easting value, and a 7-digit northing value.</DocumentationText>
    </Facet>
  </Restriction>
  <Restriction structures:id="nc.ZuluDateTimeType">
    <Name>ZuluDateTimeType</Name>
    <Namespace structures:ref="nc" xsi:nil="true"/>
    <DocumentationText>A data type for a datetime constrained to always be ZULU.</DocumentationText>
    <RestrictionBase structures:ref="xs.dateTime" xsi:nil="true"/>
    <Facet>
      <FacetCategoryCode>pattern</FacetCategoryCode>
      <FacetValue>.*Z</FacetValue>
      <DocumentationText>Restricted to UTC time zone</DocumentationText>
    </Facet>
  </Restriction>
