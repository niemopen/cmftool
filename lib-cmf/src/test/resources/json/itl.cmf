      <DocumentationText>inches</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>MM</FacetValue>
      <DocumentationText>millimeters</DocumentationText>
    </Facet>
  </Restriction>
  <Restriction structures:id="biom.ScaleUnitsCodeType">
    <Name>ScaleUnitsCodeType</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A data type for a sampling frequency unit designator, pixels per inch, or pixels per centimeter</DocumentationText>
    <RestrictionBase structures:ref="xs.integer" xsi:nil="true"/>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>0</FacetValue>
