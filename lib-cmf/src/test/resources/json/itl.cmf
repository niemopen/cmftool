  <Namespace structures:id="xs">
    <NamespaceURI>http://www.w3.org/2001/XMLSchema</NamespaceURI>
    <NamespacePrefixText>xs</NamespacePrefixText>
    <NamespaceCategoryCode>XSD</NamespaceCategoryCode>
  </Namespace>
  <DataProperty structures:id="biom.AcquisitionDigitalConversionDescriptionText">
    <Name>AcquisitionDigitalConversionDescriptionText</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A description of the analog to digital equipment used to store a representation of the source</DocumentationText>
    <Datatype structures:ref="nc.TextType" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.AcquisitionLightingSpectrumCode">
    <Name>AcquisitionLightingSpectrumCode</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A lighting spectrum used in capturing an image</DocumentationText>
    <Datatype structures:ref="biom.AcquisitionLightingSpectrumCodeType" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.AcquisitionLightingSpectrumLowerMeasure">
    <Name>AcquisitionLightingSpectrumLowerMeasure</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A lower value in nanometers for the lighting spectrum used in capturing an iris image</DocumentationText>
    <Datatype structures:ref="xs.nonNegativeInteger" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.AcquisitionLightingSpectrumUpperMeasure">
    <Name>AcquisitionLightingSpectrumUpperMeasure</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>An upper value in nanometers for the lighting spectrum used in capturing an iris image</DocumentationText>
    <Datatype structures:ref="xs.nonNegativeInteger" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.AcquisitionRadioTransmissionFormatDescriptionText">
    <Name>AcquisitionRadioTransmissionFormatDescriptionText</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>An acquisition radio transmission format description.</DocumentationText>
    <Datatype structures:ref="nc.TextType" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.AcquisitionSourceCode">
    <Name>AcquisitionSourceCode</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A kind of acquisition method for the source representation</DocumentationText>
    <Datatype structures:ref="biom.AcquisitionSourceCodeType" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.AcquisitionSourceDescriptionText">
    <Name>AcquisitionSourceDescriptionText</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A description of a vendor-specified source of an image</DocumentationText>
    <Datatype structures:ref="nc.TextType" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.AcquisitionSpecialCharacteristicsText">
    <Name>AcquisitionSpecialCharacteristicsText</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A description of any specific conditions. An example would be a near-infrared camera outputting images in visible wavelengths</DocumentationText>
    <Datatype structures:ref="nc.TextType" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.ADAReferenceCodeText">
    <Name>ADAReferenceCodeText</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A kind of ADA reference code text</DocumentationText>
    <Datatype structures:ref="nc.TextType" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.ApplicationProfileName">
    <Name>ApplicationProfileName</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A name of an application profile specification</DocumentationText>
    <Datatype structures:ref="nc.TextType" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.ApplicationProfileOrganizationName">
    <Name>ApplicationProfileOrganizationName</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A name of an agency or entity responsible for the specification of an application profile</DocumentationText>
    <Datatype structures:ref="nc.TextType" xsi:nil="true"/>
  </DataProperty>
  <ObjectProperty structures:id="biom.AssociatedContext">
    <Name>AssociatedContext</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A kind of set of identifiers pointing to an associated context representation</DocumentationText>
    <Class structures:ref="biom.AssociatedContextType" xsi:nil="true"/>
  </ObjectProperty>
  <DataProperty structures:id="biom.AssuranceAuditRevisionID">
    <Name>AssuranceAuditRevisionID</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>An identifier of an audit revision number within the revision history</DocumentationText>
    <Datatype structures:ref="biom.Integer1to999Type" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.AssuranceFormatDescriptorText">
    <Name>AssuranceFormatDescriptorText</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A descriptor for an information assurance format, as designated by its owner</DocumentationText>
    <Datatype structures:ref="nc.TextType" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.AssuranceFormatOwnerID">
    <Name>AssuranceFormatOwnerID</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>An identifier assigned to an information assurance format owner</DocumentationText>
    <Datatype structures:ref="xs.hexBinary" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.AssuranceLogAgentText">
    <Name>AssuranceLogAgentText</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A kind of the entity responsible for an event in an information assurance log entry</DocumentationText>
    <Datatype structures:ref="nc.TextType" xsi:nil="true"/>
  </DataProperty>
  <ObjectProperty structures:id="biom.AssuranceLogEntry">
    <Name>AssuranceLogEntry</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A statement of a discrete change made to another record in a transaction</DocumentationText>
    <Class structures:ref="biom.AssuranceLogEntryType" xsi:nil="true"/>
  </ObjectProperty>
  <DataProperty structures:id="biom.AssuranceLogEventCode">
    <Name>AssuranceLogEventCode</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A kind of change made to another record in a transaction</DocumentationText>
    <Datatype structures:ref="biom.AssuranceLogEventCodeType" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.AssuranceLogEventLocationText">
    <Name>AssuranceLogEventLocationText</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A kind of information items pointing to a specific record, field, and subfield</DocumentationText>
    <Datatype structures:ref="nc.TextType" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.AssuranceLogEventOriginalValueText">
    <Name>AssuranceLogEventOriginalValueText</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A kind of original value of a field before it was affected by an information assurance log event</DocumentationText>
    <Datatype structures:ref="nc.TextType" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.AssuranceLogEventReasonText">
    <Name>AssuranceLogEventReasonText</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A rationale behind an information assurance log event</DocumentationText>
    <Datatype structures:ref="nc.TextType" xsi:nil="true"/>
  </DataProperty>
  <ObjectProperty structures:id="biom.AssuranceOrganization">
    <Name>AssuranceOrganization</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>An organization creating information assurance data</DocumentationText>
    <Class structures:ref="nc.OrganizationType" xsi:nil="true"/>
  </ObjectProperty>
  <DataProperty structures:id="biom.AssuranceUTCDateTime">
    <Name>AssuranceUTCDateTime</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A date and time that information assurance data were created</DocumentationText>
    <Datatype structures:ref="nc.ZuluDateTimeType" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.AudioCaptureDeviceCode">
    <Name>AudioCaptureDeviceCode</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>An audio segment channel capture device code.</DocumentationText>
    <Datatype structures:ref="biom.AudioCaptureDeviceCodeType" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.AudioCaptureEnvironmentText">
    <Name>AudioCaptureEnvironmentText</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A description of the acoustic environment of a recording.</DocumentationText>
    <Datatype structures:ref="nc.TextType" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.AudioCommentText">
    <Name>AudioCommentText</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A comment used to note any additional information about the audio information in a record.</DocumentationText>
    <Datatype structures:ref="nc.TextType" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.AudioEqualizationText">
    <Name>AudioEqualizationText</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>An equalization that should be applied for faithful rendering of a recording on a physical media object.</DocumentationText>
    <Datatype structures:ref="nc.TextType" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.AudioObjectDescriptorCode">
    <Name>AudioObjectDescriptorCode</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A description of an object or file used to store an Audio Recording</DocumentationText>
    <Datatype structures:ref="biom.AudioObjectDescriptorCodeType" xsi:nil="true"/>
  </DataProperty>
  <ObjectProperty structures:id="biom.AudioSourceRecorder">
    <Name>AudioSourceRecorder</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A set of information regarding the captured voice</DocumentationText>
    <Class structures:ref="biom.AudioSourceRecorderType" xsi:nil="true"/>
  </ObjectProperty>
  <DataProperty structures:id="biom.AudioTrackQuantity">
    <Name>AudioTrackQuantity</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A total number of recorded tracks on a physical media object.</DocumentationText>
    <Datatype structures:ref="nc.QuantityType" xsi:nil="true"/>
  </DataProperty>
  <ObjectProperty structures:id="biom.BiometricCapture">
    <Name>BiometricCapture</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A collection of a biometric sample.</DocumentationText>
    <Class structures:ref="biom.BiometricCaptureType" xsi:nil="true"/>
  </ObjectProperty>
  <ObjectProperty structures:id="biom.BiometricDetailAbstract">
    <Name>BiometricDetailAbstract</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A data concept for capturing details.</DocumentationText>
    <AbstractIndicator>true</AbstractIndicator>
  </ObjectProperty>
  <ObjectProperty structures:id="biom.BiometricImageAbstract">
    <Name>BiometricImageAbstract</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A data concept for a biometric image</DocumentationText>
    <AbstractIndicator>true</AbstractIndicator>
  </ObjectProperty>
  <ObjectProperty structures:id="biom.CaptureDate">
    <Name>CaptureDate</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A date that an image was captured</DocumentationText>
    <Class structures:ref="nc.DateType" xsi:nil="true"/>
  </ObjectProperty>
  <DataProperty structures:id="biom.CaptureDateEstimateRangeDuration">
    <Name>CaptureDateEstimateRangeDuration</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A range of uncertainty as to when the image was captured</DocumentationText>
    <Datatype structures:ref="xs.duration" xsi:nil="true"/>
  </DataProperty>
  <ObjectProperty structures:id="biom.CaptureDevice">
    <Name>CaptureDevice</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A data type for a set of information regarding the captured device information</DocumentationText>
    <Class structures:ref="biom.DeviceType" xsi:nil="true"/>
  </ObjectProperty>
  <ObjectProperty structures:id="biom.CaptureDeviceMonitoringModeAbstract">
    <Name>CaptureDeviceMonitoringModeAbstract</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A data concept for a level of human monitoring for an image capture device</DocumentationText>
    <AbstractIndicator>true</AbstractIndicator>
  </ObjectProperty>
  <DataProperty structures:id="biom.CaptureDeviceMonitoringModeCode">
    <Name>CaptureDeviceMonitoringModeCode</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A level of human monitoring for an image capture device</DocumentationText>
    <SubPropertyOf structures:ref="biom.CaptureDeviceMonitoringModeAbstract" xsi:nil="true"/>
    <Datatype structures:ref="biom.CaptureDeviceMonitoringModeCodeType" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.CaptureHorizontalPixelDensityValue">
    <Name>CaptureHorizontalPixelDensityValue</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A scanned pixel density in horizontal direction</DocumentationText>
    <Datatype structures:ref="xs.positiveInteger" xsi:nil="true"/>
  </DataProperty>
  <ObjectProperty structures:id="biom.CaptureOrganization">
    <Name>CaptureOrganization</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>An organization that originally captured an image</DocumentationText>
    <Class structures:ref="nc.OrganizationType" xsi:nil="true"/>
  </ObjectProperty>
  <DataProperty structures:id="biom.CaptureUTCDateTime">
    <Name>CaptureUTCDateTime</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A UTC date and time for the capture of a biometric sample</DocumentationText>
    <Datatype structures:ref="xs.dateTime" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.CaptureVerticalPixelDensityValue">
    <Name>CaptureVerticalPixelDensityValue</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A scanned pixel density in the vertical direction</DocumentationText>
    <Datatype structures:ref="xs.positiveInteger" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.CBEFFCategoryCode">
    <Name>CBEFFCategoryCode</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A kind of biometric modality as described by CBEFF</DocumentationText>
    <Datatype structures:ref="biom.CBEFFCategoryCodeType" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.CBEFFFormatCategoryID">
    <Name>CBEFFFormatCategoryID</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>An identifier of a format designated by the owner</DocumentationText>
    <Datatype structures:ref="biom.HexDoubleByteType" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.CBEFFFormatOwnerID">
    <Name>CBEFFFormatOwnerID</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>An assigned identifier specifying a biometric format</DocumentationText>
    <Datatype structures:ref="biom.HexDoubleByteType" xsi:nil="true"/>
  </DataProperty>
  <ObjectProperty structures:id="biom.CBEFFImage">
    <Name>CBEFFImage</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>An image of a CBEFF record</DocumentationText>
    <SubPropertyOf structures:ref="biom.BiometricImageAbstract" xsi:nil="true"/>
    <Class structures:ref="biom.CBEFFImageType" xsi:nil="true"/>
  </ObjectProperty>
  <DataProperty structures:id="biom.CBEFFProductID">
    <Name>CBEFFProductID</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A unique registered identifier of minutiae encoding equipment; 9.126c PID</DocumentationText>
    <Datatype structures:ref="xs.hexBinary" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.CBEFFVersionID">
    <Name>CBEFFVersionID</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A identifier for the version number of the CBEFF specification that this record conforms to</DocumentationText>
    <Datatype structures:ref="nc.TextType" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.CellPhoneTowerCodeText">
    <Name>CellPhoneTowerCodeText</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A distinguishing description of the cell phone tower that relayed the audio data at the start of a specific time segment or segments.</DocumentationText>
    <Datatype structures:ref="nc.TextType" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.ChannelCommentText">
    <Name>ChannelCommentText</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A comment to identify or describe the transduction and transmission channels of a recording.</DocumentationText>
    <Datatype structures:ref="nc.TextType" xsi:nil="true"/>
  </DataProperty>
  <ObjectProperty structures:id="biom.CheiloscopicImageInformation">
    <Name>CheiloscopicImageInformation</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A data field that is particularly useful if the image contained in this record is of an injury or latent image on a person. However, its use is not limited to such circumstances. SMT size or size of injury or identifying characteristic / SMS should</DocumentationText>
    <Class structures:ref="biom.CheiloscopicImageInformationType" xsi:nil="true"/>
  </ObjectProperty>
  <DataProperty structures:id="biom.CodecCategoryCode">
    <Name>CodecCategoryCode</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A CODEC used to encode a digital data stream or signal.</DocumentationText>
    <Datatype structures:ref="biom.CodecCategoryCodeType" xsi:nil="true"/>
  </DataProperty>
  <DataProperty structures:id="biom.CodecCommentText">
    <Name>CodecCommentText</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A comment to contain additional information about the codec or additional instructions for reconstruction of the original digital media data file.</DocumentationText>
    <Datatype structures:ref="nc.TextType" xsi:nil="true"/>
  </DataProperty>
  <ObjectProperty structures:id="biom.CodecDetails">
    <Name>CodecDetails</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A container for descriptive information about the encoding of a digital media data file.</DocumentationText>
    <Class structures:ref="biom.CodecDetailsType" xsi:nil="true"/>
  </ObjectProperty>
  <DataProperty structures:id="biom.CodecExternalReferenceCodeText">
