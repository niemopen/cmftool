    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>Not Calculated</FacetValue>
      <DocumentationText>Quality score was not calculated</DocumentationText>
    </Facet>
  </Restriction>
  <Union structures:id="biom.QualityScoreType">
    <Name>QualityScoreType</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
