    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>1</FacetValue>
      <DocumentationText>Overall finger or toe print focal point</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>H</FacetValue>
      <DocumentationText>Human estimate of finger center</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>L</FacetValue>
      <DocumentationText>Lateral center only</DocumentationText>
    </Facet>
  </Restriction>
  <Restriction structures:id="biom.FrictionRidgeImageLateralReversalCodeType">
    <Name>FrictionRidgeImageLateralReversalCodeType</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A data type for an indication that an image is or may be laterally reversed</DocumentationText>
    <RestrictionBase structures:ref="xs.token" xsi:nil="true"/>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>L</FacetValue>
      <DocumentationText>Image is known to be laterally reversed</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>U</FacetValue>
      <DocumentationText>Image may be laterally reversed</DocumentationText>
    </Facet>
  </Restriction>
  <Restriction structures:id="biom.FrictionRidgeImageTonalReversalCodeType">
    <Name>FrictionRidgeImageTonalReversalCodeType</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A data type for a full or partial reversal of ridge and valley tones</DocumentationText>
    <RestrictionBase structures:ref="xs.token" xsi:nil="true"/>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>N</FacetValue>
      <DocumentationText>Negative; ridges are light and valleys are dark throughout the image</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>P</FacetValue>
      <DocumentationText>Partial; ridges are light and valleys are dark only in portions of the image</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>U</FacetValue>
      <DocumentationText>Unknown</DocumentationText>
    </Facet>
  </Restriction>
