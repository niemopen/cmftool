  <Restriction structures:id="biom.ImageHashValueType">
    <Name>ImageHashValueType</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A data type for a hash value computed from a binary object, like an image</DocumentationText>
    <RestrictionBase structures:ref="xs.string" xsi:nil="true"/>
    <Facet>
      <FacetCategoryCode>pattern</FacetCategoryCode>
      <FacetValue>([0-9a-fA-F]){64}</FacetValue>
      <DocumentationText>A hash value of pattern ([0-9a-fA-F]){64} is allowed.</DocumentationText>
    </Facet>
  </Restriction>
  <Restriction structures:id="biom.ImageOcclusionCategoryCodeType">
    <Name>ImageOcclusionCategoryCodeType</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A data type for a kind of blockage in an image</DocumentationText>
    <RestrictionBase structures:ref="xs.token" xsi:nil="true"/>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>C</FacetValue>
      <DocumentationText>Shadow cast</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>H</FacetValue>
      <DocumentationText>Hair, hat, veil, burqa, or other head covering (face only)</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>L</FacetValue>
      <DocumentationText>Eyelashes or reflections of eyelashes (iris only)</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>O</FacetValue>
      <DocumentationText>Any other occlusion, such as eyeglass frames blocking the image</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>R</FacetValue>
      <DocumentationText>Reflection of an object</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>S</FacetValue>
      <DocumentationText>Specularity, reflection of light</DocumentationText>
    </Facet>
  </Restriction>
  <Restriction structures:id="biom.ImageOcclusionOpacityCodeType">
    <Name>ImageOcclusionOpacityCodeType</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A data type for an opacity of a blockage in an image</DocumentationText>
    <RestrictionBase structures:ref="xs.token" xsi:nil="true"/>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>I</FacetValue>
      <DocumentationText>Interference</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>L</FacetValue>
      <DocumentationText>Partial light</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>S</FacetValue>
      <DocumentationText>Partial shadow</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>T</FacetValue>
