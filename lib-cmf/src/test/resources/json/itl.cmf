  <Restriction structures:id="itl.TwoCharacterTextType">
    <Name>TwoCharacterTextType</Name>
    <Namespace structures:ref="itl" xsi:nil="true"/>
    <DocumentationText>A user-generated text string that is limited to two characters only</DocumentationText>
    <RestrictionBase structures:ref="nc.TextType" xsi:nil="true"/>
    <Facet>
      <FacetCategoryCode>length</FacetCategoryCode>
      <FacetValue>2</FacetValue>
    </Facet>
  </Restriction>
  <Restriction structures:id="mo.MGRSCoordinateStringType">
    <Name>MGRSCoordinateStringType</Name>
    <Namespace structures:ref="mo" xsi:nil="true"/>
    <DocumentationText>A data type for a complete coordinate string from the Military Grid Reference System (MGRS) which represents a location with a Universal Transverse Mercator (UTM) or Univeral Polar Steriographic (UPS) coordinate and a unique military grid square.</DocumentationText>
    <RestrictionBase structures:ref="xs.string" xsi:nil="true"/>
    <Facet>
      <FacetCategoryCode>pattern</FacetCategoryCode>
      <FacetValue>(((0[1-9]|[1-5][0-9]|60)[C-HJ-NP-X][A-HJ-NP-Z][A-HJ-NP-V])|([ABYZ][A-CF-HJ-LP-UX-Z][A-HJ-NP-Z]))([0-9][0-9]){0,5}</FacetValue>
      <DocumentationText>MGRS coordinate pattern</DocumentationText>
    </Facet>
  </Restriction>
  <Restriction structures:id="nc.AngularMinuteType">
    <Name>AngularMinuteType</Name>
    <Namespace structures:ref="nc" xsi:nil="true"/>
