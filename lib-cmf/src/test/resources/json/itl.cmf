    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>10</FacetValue>
      <DocumentationText>Other/unknown matrix</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>2</FacetValue>
      <DocumentationText>Blood</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>3</FacetValue>
      <DocumentationText>Paint</DocumentationText>
