    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>1</FacetValue>
      <DocumentationText>Pixels per inch</DocumentationText>
    </Facet>
    <Facet>
      <FacetCategoryCode>enumeration</FacetCategoryCode>
      <FacetValue>2</FacetValue>
      <DocumentationText>Pixels per centimeter</DocumentationText>
    </Facet>
  </Restriction>
  <Restriction structures:id="biom.ScanningResolutionCategoryCodeType">
    <Name>ScanningResolutionCategoryCodeType</Name>
    <Namespace structures:ref="biom" xsi:nil="true"/>
    <DocumentationText>A data type for an indication of whether minimal (nominal) or native scanning resolution applies to a biometric image.</DocumentationText>
