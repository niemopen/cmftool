# curie_map:
#   sm: http://example.com/ReqRes/1.0/simpleJSON
#   msg: http://example.com/ReqRes/1.0/
#   nc: https://docs.oasis-open.org/niemopen/ns/model/niem-core/6.0/
#   owl: http://www.w3.org/2002/07/owl#
# NoPrefix: true
subject_id	predicate_id	object_id
msg:Request	owl:sameAs	sm:request
msg:RequestedItem	owl:sameAs	sm:item
msg:RequestID	owl:sameAs	sm:id
nc:ItemName	owl:sameAs	sm:name
nc:ItemQuantity	owl:sameAs	sm:quantity
nc:QuantityLiteral	owl:sameAs	sm:number
nc:quantityUnitText	owl:sameAs	sm:units
